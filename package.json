{
  "name": "agent-room",
  "version": "1.0.0",
  "private": true,
  "description": "Agent sessions that message each other in rooms, over A2A",
  "type": "module",
  "bin": {
    "agent-room": "src/install/bootstrap.js"
  },
  "files": [
    "src",
    "skills",
    "extras",
    "web/dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --test-timeout=20000 \"test/*.test.ts\"",
    "check": "tsc -p tsconfig.json",
    "lint": "oxlint src test",
    "build:web": "npm --prefix web install && npm --prefix web run build"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
